{
	chapter.1433B4488A376ED9.title: "1. Initial Survival"
	chapter_group.14BC9E7D4CDCBC30.title: "Act I"
	quest.2D1E55060C67E4F8.quest_desc: ["Water can be difficult to find in this world, and source water blocks don't replenish. But once you have water, you can create a water farm by putting a block of water over dripstone and letting the drips slowly collect into a cauldron. You can also put an empty cauldron in the rain and it will slowly fill with rainwater."]
	quest.2D1E55060C67E4F8.title: "Find Water"
}
